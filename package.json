{
  "name": "matterbridge-myio",
  "version": "0.1.3",
  "description": "Matterbridge plugin for myIO smart home controllers",
  "author": "myIO Smart Home Zrt.",
  "license": "Apache-2.0",
  "homepage": "https://www.npmjs.com/package/matterbridge-myio",
  "help": "https://www.npmjs.com/package/matterbridge-myio#readme",
  "changelog": "https://unpkg.com/matterbridge-myio/CHANGELOG.md",
  "keywords": [
    "matterbridge",
    "plugin",
    "myio",
    "matter",
    "smarthome",
    "google-home",
    "alexa",
    "homeassistant",
    "homekit",
    "apple-home",
    "smartthings"
  ],
  "type": "module",
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "import": "./dist/module.js",
      "types": "./dist/module.d.ts"
    }
  },
  "engines": {
    "node": ">=22.13.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "*.config.json",
    "*.schema.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "watch": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "e2e": "npm run build && node scripts/run-node22.mjs test/e2e.mjs",
    "dev:link": "node scripts/link-matterbridge.mjs",
    "bench": "node scripts/run-node22.mjs scripts/bench.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
